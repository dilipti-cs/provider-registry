# This file specifies files that should not be uploaded to Google Cloud
# during deployment with gcloud

# Git files
.git
.gitignore
.github

# Node modules (will be installed during build)
node_modules/
npm-debug.log

# Build output (will be generated during build)
dist/
build/

# Development files
.env
.env.local
.env.development
.env.test

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Documentation (optional - remove if you want to include)
*.md
!README.md

# Docker files (not needed for Cloud Build)
docker-compose.yml

# Test files
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Terraform state files
terraform/
*.tfstate
*.tfstate.backup
